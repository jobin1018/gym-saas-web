# Must be the legacy JWT-format anon key (starts with "eyJ..."), not the
# newer sb_publishable_... format — the staff-login Edge Function's
# verify_jwt gateway check rejects the publishable-key format outright.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=paste_your_local_legacy_jwt_anon_key_here
